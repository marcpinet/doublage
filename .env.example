# Copy this file to .env and fill in your values. .env is gitignored.
# One .env at the repo root is read by the host app and by the relay.

# --- Host (preprocessing + hosting) ---

# HuggingFace token for pyannote diarization. Accept the model EULA at
# huggingface.co/pyannote/speaker-diarization-3.1 first.
HUGGINGFACE_TOKEN=hf_your_token_here

# Relay the host connects to by default (override with --relay).
RELAY_URL=http://127.0.0.1:21826

# --- Relay (the machine that hosts rooms) ---

HOST=0.0.0.0
PORT=21826

# Where room bundles and takes are stored (ephemeral, cleaned by TTL).
STORAGE_DIR=./relay_storage

# Close and delete a room after this many minutes of inactivity.
ROOM_TTL_MIN=240

# Delete a room this many minutes after everyone has left.
EMPTY_ROOM_GRACE_MIN=5

# Reject a room bundle larger than this many megabytes.
MAX_ROOM_MB=800

# Reject a single recorded take larger than this many megabytes.
MAX_TAKE_MB=64

# Caps against scanners/abuse: max simultaneous rooms, max players per room.
MAX_ROOMS=50
MAX_MEMBERS_PER_ROOM=24

# Comma-separated allowed origins, or * for any.
ALLOWED_ORIGINS=*

# Public base URL of the relay, used only for the link preview (Open Graph) when a
# room link is shared. Leave empty if you do not care about embeds.
# Example: PUBLIC_URL=https://relay.example.com
PUBLIC_URL=
